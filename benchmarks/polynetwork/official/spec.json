    {"name": "EthCrossChainData", "contract": "EthCrossChainData", "side": "dest", "args": []},
    {"name": "LockProxy", "contract": "LockProxy", "side": "dest", "args": ["$EthToken"]},
    {"name": "EthCrossChainManager", "contract": "EthCrossChainManager", "side": "dest", "args": ["$EthCrossChainData"]},
    {"name": "SrcToken", "contract": "OfficialToken", "side": "source", "args": ["Bridged asset (source)"]},
    {"name": "SourceCrossChain", "contract": "SourceCrossChain", "side": "source", "args": []},
    {"name": "SrcDeposit", "contract": "SrcDeposit", "side": "source", "args": ["$SrcToken", "$SourceCrossChain", "$LockProxy"]}
  ],
  "victims": ["0x000000000000000000000000000000000000Ab01"],
  "setup": [
    {"from": "deployer", "to": "$EthToken", "fn": "mint", "args": ["$LockProxy", "1000000e18"]},
    {"from": "deployer", "to": "$EthCrossChainData", "fn": "initKeeper", "args": ["relayer"]},
    {"from": "deployer", "to": "$EthCrossChainData", "fn": "transferOwnership", "args": ["$EthCrossChainManager"]},
    {"from": "deployer", "to": "$LockProxy", "fn": "setManager", "args": ["$EthCrossChainManager"]},
    {"from": "deployer", "to": "$LockProxy", "fn": "setRegisteredProxy", "args": ["$SrcDeposit"]},
    {"from": "deployer", "to": "$SrcToken", "fn": "mint", "args": ["0x000000000000000000000000000000000000Ab01", "1000e18"]},
