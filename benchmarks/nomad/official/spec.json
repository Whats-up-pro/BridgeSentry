    {"name": "NomadReplica", "contract": "NomadReplica", "side": "dest", "args": []},
    {"name": "Representation", "contract": "OfficialToken", "side": "dest", "args": ["Nomad representation token"]},
    {"name": "NomadBridgeRouter", "contract": "NomadBridgeRouter", "side": "dest", "args": ["$NomadReplica", "$Representation"]}
