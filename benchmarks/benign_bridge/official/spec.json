{
  "fixture_id": "benign_bridge",
  "notes": "Benign hard-negative, independent of any exploit. A correct lock->mint bridge: a deposit on the source chain locks real tokens via transferFrom and the faithful relay releases an equal amount of the wrapped token from a pre-funded pool on the destination chain, payable only by the relayer. No path releases value without a matching, funded deposit. Under the paired assets [SrcToken,DstToken] a legitimate deposit-and-release nets to zero, and adversarial fuzzing from ordinary accounts gains nothing. Used to estimate the oracle false-positive rate on code that is not an exploit. vulnerable == patched (no flaw to fix).",
  "variants": {
    "vulnerable": "official/vulnerable",
    "patched": "official/patched"
  },
  "cross_chain": true,
  "deploy": [
    {
      "name": "SrcToken",
      "contract": "OfficialToken",
      "side": "source",
      "args": [
        "Benign bridged token"
      ]
    },
    {
      "name": "LockBridge",
      "contract": "LockBridge",
      "side": "source",
      "args": [
        "$SrcToken"
      ]
    },
    {
      "name": "DstToken",
      "contract": "OfficialToken",
      "side": "dest",
      "args": [
        "Benign wrapped token"
      ]
    },
    {
      "name": "MintBridge",
      "contract": "MintBridge",
      "side": "dest",
      "args": [
        "$DstToken",
        "0x00000000000000000000000000000000000Be1a7"
      ]
    }
  ],
  "victims": [],
  "setup": [
    {
      "from": "deployer",
      "to": "$DstToken",
      "fn": "mint",
      "args": [
        "$MintBridge",
        "1000000e18"
      ]
    },
    {
      "from": "deployer",
      "to": "$SrcToken",
      "fn": "mint",
      "args": [
        "attacker",
        "1000e18"
      ]
    },
    {
      "from": "attacker",
      "to": "$SrcToken",
      "fn": "approve",
      "args": [
        "$LockBridge",
        "1000e18"
      ]
    }
  ],
  "relay": [
    {
      "emitter": "LockBridge",
      "event": "Deposit",
      "to": "MintBridge",
      "fn": "release",
      "args": [
        "ev:recipient",
        "ev:amount"
      ]
    }
  ],
  "asset_pairs": [
    [
      "SrcToken",
      "DstToken"
    ]
  ],
  "release_entrypoints": [
    "MintBridge.release"
  ]
}